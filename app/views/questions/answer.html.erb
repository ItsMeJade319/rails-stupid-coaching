<div class="container pt-5">
  <div class="card mb-4" style="width: 18rem;">
    <div class="card-body">
      <h5><%= params[:question] %></h5>
      <p class="fst-italic">- You</p>
    </div>
  </div>
  <div class="card mb-4 text-bg-secondary" style="width: 18rem;">
    <div class="card-body">
      <h5><%= @answer %></h5>
      <p class="fst-italic">- Your coach</p>
    </div>
  </div>
<%= link_to "Ask a new question", ask_path %>
</div>
